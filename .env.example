# Fidelio ortam değişkenleri örneği.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. Gerçek değerleri ASLA bu dosyaya yazmayın.

# ===== Sunucu =====
PORT=3001
# Yerel geliştirmede yalnızca bu makineden erişim için 127.0.0.1 kullanın.
LISTEN_HOST=0.0.0.0
# NODE_ENV=production değerini .env yerine sunucu ortamında (hosting paneli) ayarlayın; Vite .env içindeki NODE_ENV'i desteklemez.
# Ters proxy arkasında gerçek istemci IP'si için (ör. 1 = tek proxy). Boşsa 'loopback'.
TRUST_PROXY=loopback
# Virgülle ayrılmış izinli originler. Boş bırakılırsa CORS herkese açık olur (uyarı loglanır).
ALLOWED_ORIGINS=https://alanadiniz.com,http://localhost:3000

# ===== Kimlik doğrulama =====
# ZORUNLU (production): en az 32 karakterlik rastgele değer. Üretmek için: openssl rand -base64 48
# Boş bırakılırsa her başlatmada rastgele bir secret üretilir (uyarı loglanır, yeniden başlatınca oturumlar düşer).
JWT_SECRET=
# Herkese açık kayıt (POST /api/auth/register). Varsayılan kapalı.
ALLOW_REGISTRATION=false

# ===== TradingView webhook =====
# TradingView alarm mesajındaki "secret" alanıyla aynı olmalı. Tanımlı değilse webhook 503 döner.
# Üretmek için: openssl rand -base64 32
WEBHOOK_SECRET=

# ===== Veritabanı (MySQL) =====
DB_HOST=veritabani-sunucusu
DB_PORT=3306
DB_USER=veritabani-kullanicisi
DB_PASSWORD=veritabani-sifresi
DB_NAME=veritabani-adi
# TLS: false = şifresiz (yalnızca yerel geliştirme veritabanı için).
DB_SSL=true
# Sağlayıcının CA sertifika dosyası (verilirse sertifika doğrulanır).
DB_SSL_CA=
# true = sunucu sertifikasını doğrula (önerilen). Boş/false = doğrulama kapalı (uyarı loglanır).
DB_SSL_REJECT_UNAUTHORIZED=

# ===== Yapay zekâ =====
GEMINI_API_KEY=

# ===== Frontend (Vite, build sırasında okunur) =====
# Boş = aynı origin (frontend bu sunucudan servis edildiğinde).
VITE_API_URL=
